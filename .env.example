# ═══════════════════════════════════════════════════════════════════
# Royal Glow Salon & Spa — Environment Variables (root template)
# Copy to .env.local and fill in your values. Names here are CANONICAL
# and match environment-variables.md + apps/web/src/env.ts exactly.
# apps/cms has its own apps/cms/.env.example (CMS-only subset).
# ═══════════════════════════════════════════════════════════════════

# ─── Database (Neon PostgreSQL) ──────────────────────────────────
# Get from: https://console.neon.tech → Project → Connection Details
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host-direct/dbname?sslmode=require"

# ─── Auth (Better Auth) ──────────────────────────────────────────
# Self-hosted mode: BETTER_AUTH_SECRET (random 32+ char string).
# Cloud mode: BETTER_AUTH_API_KEY from https://dash.better-auth.com
# Provide whichever mode you use; both are accepted.
BETTER_AUTH_API_KEY=""
BETTER_AUTH_URL="http://localhost:3000"

# ─── Auth (Google OAuth) ─────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_OAUTH_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="your-google-client-secret"

# ─── Email — Transactional (Resend) ──────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="Royal Glow <contact@theroyalglow.in>"

# ─── Email — Marketing (Brevo) ───────────────────────────────────
BREVO_API_KEY="xkeysib-your-brevo-api-key"

# ─── Realtime (Ably) ─────────────────────────────────────────────
# Get from: https://ably.com/accounts → App → API Keys
ABLY_PRIVATE_KEY="your-ably-private-key"
NEXT_PUBLIC_ABLY_KEY="your-ably-public-key"

# ─── Cache (Upstash Redis) ───────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"

# ─── Queue (Upstash QStash) ──────────────────────────────────────
QSTASH_URL="https://qstash-eu-central-1.upstash.io"
QSTASH_TOKEN="your-qstash-token"
QSTASH_CURRENT_SIGNING_KEY="your-qstash-current-signing-key"
QSTASH_NEXT_SIGNING_KEY="your-qstash-next-signing-key"

# ─── File Storage (Cloudflare R2) ────────────────────────────────
# Get from: https://dash.cloudflare.com → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="theroyalglow-uploads"
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
NEXT_PUBLIC_R2_PUBLIC_URL="https://uploads.theroyalglow.in"

# ─── Cloudflare (KV + Workers, CI/CD) ────────────────────────────
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"
CLOUDFLARE_KV_NAMESPACE_ID="your-kv-namespace-id"

# ─── Web Push (VAPID) ────────────────────────────────────────────
# Generate once: bunx web-push generate-vapid-keys
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:contact@theroyalglow.in"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"

# ─── PDF Invoice Service (Google Cloud Run — rgss-invoicing) ─────
PDF_API_URL="https://rgss-invoicing-<hash>.asia-south1.run.app"

# ─── Ads & Tracking (Meta Pixel + CAPI) ──────────────────────────
META_PIXEL_ACCESS_TOKEN="your-meta-pixel-access-token"
META_CAPI_WEBHOOK_TOKEN="your-meta-capi-webhook-token"
# META_TEST_EVENT_CODE="TESTxxxxx"   # dev/pprd only — omit in prod
NEXT_PUBLIC_META_PIXEL_ID="your-meta-pixel-id"

# ─── Analytics (PostHog + Clarity) ───────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY="phc_your-posthog-project-key"
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
NEXT_PUBLIC_CLARITY_ID="your-clarity-id"

# ─── CRM & Leads (AiSensy) ───────────────────────────────────────
AISENSY_API_KEY="your-aisensy-api-key"
AISENSY_WEBHOOK_SECRET="your-aisensy-webhook-secret"

# ─── Reporting (Slack + Email) ───────────────────────────────────
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/xxx/yyy/zzz"
DAILY_REPORT_EMAIL_RECIPIENTS="owner@theroyalglow.in,manager@theroyalglow.in"

# ─── Observability (Sentry) ──────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"        # CI/CD only
SENTRY_ORG="royal-glow"                            # CI/CD only
SENTRY_PROJECT="rgss"                              # CI/CD only

# ─── Observability (BetterStack) ─────────────────────────────────
BETTER_STACK_TOKEN="your-betterstack-source-token"
# Uptime API token (Settings -> API tokens -> Uptime). Used ONLY by
# scripts/provision-betterstack.ts to create monitors + status.theroyalglow.in.
# Set BETTER_STACK_TEAM_NAME too if the token is a GLOBAL token.
BETTER_STACK_API_TOKEN="your-betterstack-uptime-api-token"
# BETTER_STACK_TEAM_NAME="Royal Glow Salon & Spa"
BETTER_STACK_HEARTBEAT_NIGHTLY_SALES="https://uptime.betterstack.com/api/v1/heartbeat/nightly-sales"
BETTER_STACK_HEARTBEAT_REMINDERS="https://uptime.betterstack.com/api/v1/heartbeat/reminders"
BETTER_STACK_HEARTBEAT_MEMBERSHIP_EXPIRY="https://uptime.betterstack.com/api/v1/heartbeat/membership-expiry"
BETTER_STACK_HEARTBEAT_SESSION_CLEANUP="https://uptime.betterstack.com/api/v1/heartbeat/session-cleanup"
# Pinged ONLY when the daily CMS ↔ public service-catalogue reconciliation finds
# no drift — a withheld ping is the drift alert.
BETTER_STACK_HEARTBEAT_SERVICE_DRIFT="https://uptime.betterstack.com/api/v1/heartbeat/service-drift"
# CI/CD-only heartbeats/webhooks (not in apps/web/src/env.ts):
BETTER_STACK_HEARTBEAT_PPRD_SYNC="https://uptime.betterstack.com/api/v1/heartbeat/pprd-sync"
BETTER_STACK_HEARTBEAT_BACKUP="https://uptime.betterstack.com/api/v1/heartbeat/backup"
BETTER_STACK_DEPLOY_WEBHOOK="https://uptime.betterstack.com/api/v1/deploy/your-id"
BETTER_STACK_INCIDENT_WEBHOOK="https://uptime.betterstack.com/api/v1/incident/your-id"

# ─── CMS (Payload) ───────────────────────────────────────────────
PAYLOAD_SECRET="your-payload-secret-min-32-chars"

# ─── App Configuration ───────────────────────────────────────────
APP_ENV="dev"                                      # dev | test | pprd | prod
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CMS_URL="http://localhost:3002"

# ─── CI/CD ───────────────────────────────────────────────────────
SKIP_ENV_VALIDATION="false"

# ─── Neon MCP (Kiro IDE only — not used by the app) ──────────────
# Used by .kiro/settings/mcp.json to enable direct DB access from Kiro.
# Get from: https://console.neon.tech → Profile → Account Settings → API Keys
NEON_API_KEY=""
