# ═══════════════════════════════════════════════════════════════
# Royal Glow Salon & Spa — Monorepo .gitignore
# Turborepo + Bun + Next.js
# ═══════════════════════════════════════════════════════════════

# ─── Dependencies ─────────────────────────────────────────────
node_modules/

# ─── Build outputs ────────────────────────────────────────────
.next/
dist/
.turbo/
*.tsbuildinfo

# ─── Environment files ────────────────────────────────────────
.env
.env.local
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Plaintext local-runtime secrets (legacy filename, still sensitive).
.dev.vars
.dev.vars.*

# ─── Bun ──────────────────────────────────────────────────────
bun.lockb

# ─── TypeScript ───────────────────────────────────────────────
*.tsbuildinfo

# ─── Test coverage ────────────────────────────────────────────
coverage/

# ─── Playwright artifacts ─────────────────────────────────────
# Emitted by every Playwright config in the repo (root, apps/admin,
# apps/cms) on each run — reports, traces, screenshots. Derived output.
playwright-report/
test-results/
blob-report/
playwright/.cache/

# ─── IDE files ────────────────────────────────────────────────
.idea/
*.swp
*.swo
*~

# ─── OS files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── Local scratch scripts ────────────────────────────────────
# Throwaway probe/helper scripts written during a debugging session, kept at the
# repo root while the session is live (e.g. tmp-sst.ps1, tmp-cfprobe.ps1).
# Root-anchored so a legitimately committed tmp-* file deeper in the tree is
# unaffected. Promote anything worth keeping into scripts/ under a real name.
/tmp-*

# ─── Misc ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Graphify (knowledge graph) ───────────────────────────────
graphify-out/
.graphify_*.json
.graphify_*.txt

# ─── Kiro MCP settings (contains API keys) ───────────────────
.kiro/settings/
# Added by code-review-graph
.code-review-graph/

# ─── OpenNext (generated by SST for AWS) ─────────────────────
# `sst.aws.Nextjs` emits its derived AWS Lambda/CloudFront bundle here.
# It is regenerated by SST and must never be committed.
.open-next/

# --- ltm-power ---
ltm/store/*.jsonl
ltm/runtime/*
ltm/reports/*
ltm/snapshots/*
# --- /ltm-power ---

# --- AWS deployment (M2AWS) ---
# SST generated platform files + local stage state.
.sst/
# SST generated typed-env ambient declarations. `sst dev` / `sst deploy`
# recreates one at the repo root and one in EVERY workspace, so the bare
# pattern (no leading slash) matches at any depth. Keep the files locally —
# SST wants them for typechecking — but never commit them.
sst-env.d.ts
# Archived EC2-path env blobs (that path is not in use — see
# infra/aws/_ec2-path/ARCHIVED.md). Templates ARE committed.
infra/aws/_ec2-path/env/*.env
!infra/aws/_ec2-path/env/*.env.example
