# ═══════════════════════════════════════════════════════════════
# Royal Glow Salon & Spa — Monorepo .gitignore
# Turborepo + Bun + Next.js
# ═══════════════════════════════════════════════════════════════

# ─── Dependencies ─────────────────────────────────────────────
node_modules/

# ─── Build outputs ────────────────────────────────────────────
.next/
dist/
.turbo/
*.tsbuildinfo

# ─── Environment files ────────────────────────────────────────
.env
.env.local
.env*.local
.env.development.local
.env.test.local
.env.production.local

# ─── Bun ──────────────────────────────────────────────────────
bun.lockb

# ─── TypeScript ───────────────────────────────────────────────
*.tsbuildinfo

# ─── Test coverage ────────────────────────────────────────────
coverage/

# ─── Playwright artifacts ─────────────────────────────────────
# Emitted by every Playwright config in the repo (root, apps/admin,
# apps/cms) on each run — reports, traces, screenshots. Derived output.
playwright-report/
test-results/
blob-report/
playwright/.cache/

# ─── IDE files ────────────────────────────────────────────────
.idea/
*.swp
*.swo
*~

# ─── OS files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── Misc ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Graphify (knowledge graph) ───────────────────────────────
graphify-out/
.graphify_*.json
.graphify_*.txt

# ─── Kiro MCP settings (contains API keys) ───────────────────
.kiro/settings/
# Added by code-review-graph
.code-review-graph/

# ─── OpenNext (Cloudflare Workers adapter) ────────────────────
# `opennextjs-cloudflare build` emits the Worker bundle + transformed
# assets here. It is a derived build artifact (like .next/) and must never
# be committed — CI/Cloudflare regenerate it on every deploy.
.open-next/
# Wrangler local state + the generated typed-env ambient declaration.
.wrangler/
cloudflare-env.d.ts
# Local Workers dev secrets (mirrors .env.local; never commit).
.dev.vars
.dev.vars.*

# --- ltm-power ---
ltm/store/*.jsonl
ltm/runtime/*
ltm/reports/*
ltm/snapshots/*
# --- /ltm-power ---

# --- AWS deployment (M2AWS) ---
# SST generated platform files + local stage state.
.sst/
# Archived EC2-path env blobs (that path is not in use — see
# infra/aws/_ec2-path/ARCHIVED.md). Templates ARE committed.
infra/aws/_ec2-path/env/*.env
!infra/aws/_ec2-path/env/*.env.example
