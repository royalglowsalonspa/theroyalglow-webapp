# ═══════════════════════════════════════════════════════════════
# Royal Glow Salon & Spa — Monorepo .gitignore
# Turborepo + Bun + Next.js
# ═══════════════════════════════════════════════════════════════

# ─── Dependencies ─────────────────────────────────────────────
node_modules/

# ─── Build outputs ────────────────────────────────────────────
.next/
dist/
.turbo/
*.tsbuildinfo

# ─── Environment files ────────────────────────────────────────
.env
.env.local
.env*.local
.env.development.local
.env.test.local
.env.production.local

# ─── Bun ──────────────────────────────────────────────────────
bun.lockb

# ─── TypeScript ───────────────────────────────────────────────
*.tsbuildinfo

# ─── Test coverage ────────────────────────────────────────────
coverage/

# ─── IDE files ────────────────────────────────────────────────
.idea/
*.swp
*.swo
*~

# ─── OS files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── Misc ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Graphify (knowledge graph) ───────────────────────────────
graphify-out/
.graphify_*.json
.graphify_*.txt

# ─── Kiro MCP settings (contains API keys) ───────────────────
.kiro/settings/
# Added by code-review-graph
.code-review-graph/

# ─── OpenNext (Cloudflare Workers adapter) ────────────────────
# `opennextjs-cloudflare build` emits the Worker bundle + transformed
# assets here. It is a derived build artifact (like .next/) and must never
# be committed — CI/Cloudflare regenerate it on every deploy.
.open-next/
# Wrangler local state + the generated typed-env ambient declaration.
.wrangler/
cloudflare-env.d.ts
# Local Workers dev secrets (mirrors .env.local; never commit).
.dev.vars
.dev.vars.*

# --- ltm-power ---
ltm/store/*.jsonl
ltm/runtime/*
ltm/reports/*
ltm/snapshots/*
# --- /ltm-power ---
