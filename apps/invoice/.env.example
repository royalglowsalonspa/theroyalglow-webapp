# Invoicing service configuration. Use a separate bucket for local fixtures.
PORT=8080
INVOICE_PDF_HMAC_SECRET=

# Production invoice PDFs use private R2 with bucket-scoped credentials.
R2_BUCKET_NAME=rgss-invoices
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_INVOICE_ACCESS=private

# Required only when running in legacy public mode.
R2_PUBLIC_BASE_URL=
