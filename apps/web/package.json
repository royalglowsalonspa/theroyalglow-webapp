{
  "name": "@rgss/web",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "//dev": "Turbopack, the Next 16 default and the bundler `next build` uses. Until 27/09/2026 this was --webpack, because Windows Application Control on the maintainer's machine blocked the native SWC binary Turbopack needs; that binary loads again. `dev:webpack` is the fallback if it is ever blocked again.",
    "dev": "next dev --turbopack -p 3000",
    "dev:webpack": "next dev --webpack -p 3000",
    "build": "next build",
    "start": "next start",
    "start:prod": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ./src"
  },
