{
  "name": "@rgss/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "check:tokens": "node scripts/assert-token-presence.mjs",
    "prebuild": "node scripts/assert-token-presence.mjs",
    "build": "next build",
    "start": "next start",
    "start:prod": "next start -p ${PORT:-3001}",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ./src",
    "register-schedules": "bun run scripts/register-schedules.ts",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@better-auth/infra": "^0.3.7",
    "@neondatabase/serverless": "^1.1.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@rgss/business": "workspace:*",
    "@rgss/db": "workspace:*",
    "@rgss/errors": "workspace:*",
    "@rgss/logger": "workspace:*",
    "@rgss/types": "workspace:*",
    "@rgss/ui": "workspace:*",
    "@sentry/nextjs": "^10.68.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "@upstash/qstash": "^2.11.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "ably": "^2.26.0",
    "better-auth": "1.6.23",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.2",
    "kysely": "0.29.4",
    "lucide-react": "1.27.0",
    "motion": "12.42.2",
    "nanoid": "^6.0.0",
    "next": "16.2.12",
    "next-themes": "0.4.6",
    "postcss": "^8.5.23",
    "radix-ui": "1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "resend": "^6.18.0",
    "sonner": "2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "fast-check": "^4.9.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0",
    "wrangler": "^4.114.0"
  }
}
