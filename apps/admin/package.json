{
  "name": "@rgss/admin",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "//dev": "Turbopack, the Next 16 default and the bundler `next build` uses. Until 27/09/2026 this was --webpack, because Windows Application Control on the maintainer's machine blocked the native SWC binary Turbopack needs; that binary loads again. `dev:webpack` is the fallback if it is ever blocked again.",
    "dev": "next dev --turbopack -p 3001",
    "dev:webpack": "next dev --webpack -p 3001",
    "check:tokens": "node scripts/assert-token-presence.mjs",
    "prebuild": "node scripts/assert-token-presence.mjs",
    "build": "next build",
    "start": "next start",
    "start:prod": "next start -p ${PORT:-3001}",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ./src",
    "register-schedules": "bun run scripts/register-schedules.ts",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list"
  },
  "dependencies": {
    "@better-auth/infra": "0.4.11",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@rgss/business": "workspace:*",
    "@rgss/db": "workspace:*",
    "@rgss/errors": "workspace:*",
    "@rgss/logger": "workspace:*",
    "@rgss/types": "workspace:*",
    "@rgss/ui": "workspace:*",
    "@sentry/nextjs": "10.75.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-table": "^9.1.2",
    "@upstash/qstash": "^2.11.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "ably": "^2.29.0",
    "better-auth": "1.7.6",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.2",
    "kysely": "0.29.6",
    "lucide-react": "1.48.0",
    "motion": "13.4.3",
    "nanoid": "^6.0.1",
    "next": "16.3.6",
    "next-themes": "0.4.6",
    "postcss": "^8.5.28",
    "radix-ui": "1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "resend": "^6.29.0",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "5.0.1",
    "fast-check": "^4.10.1",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.0",
    "msw": "^2.15.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "wait-on": "^9.1.0"
  }
