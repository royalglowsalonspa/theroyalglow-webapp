{
  "name": "@rgss/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "check:tokens": "node scripts/assert-token-presence.mjs",
    "prebuild": "node scripts/assert-token-presence.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ./src",
    "register-schedules": "bun run scripts/register-schedules.ts",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@better-auth/infra": "^0.3.4",
    "@opennextjs/cloudflare": "^1.20.1",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@rgss/business": "workspace:*",
    "@rgss/db": "workspace:*",
    "@rgss/errors": "workspace:*",
    "@rgss/logger": "workspace:*",
    "@rgss/types": "workspace:*",
    "@rgss/ui": "workspace:*",
    "@sentry/nextjs": "^9",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tailwindcss/postcss": "^4.3.1",
    "@tanstack/react-table": "^8.21.3",
    "@upstash/qstash": "^2.11.1",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.7",
    "ably": "^2.23.0",
    "better-auth": "^1.6.22",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "kysely": "0.29.2",
    "lucide-react": "1.22.0",
    "nanoid": "^5.1.16",
    "next": "16.2.9",
    "postcss": "^8.5.16",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.0",
    "resend": "^6.16.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.3.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.9",
    "fast-check": "^3.23.1",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "msw": "^2.7.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.9",
    "wait-on": "^8.0.1",
    "wrangler": "^4.105.0"
  }
}
