# ═══════════════════════════════════════════════════════════════════
# Royal Glow Salon & Spa — Admin App Environment Variables (template)
# App: apps/admin  →  admin.theroyalglow.in  (dev port 3001)
#
# Copy to apps/admin/.env.local and fill in your values.
# Typed names below match apps/admin/src/env.ts. Additional guarded job/
# notification variables are documented in knowledge-base/environment-variables.md.
#
# ADMIN-SCOPED ONLY. Customer tracking vars (Meta Pixel, PostHog,
# Clarity, VAPID public) are intentionally OMITTED — they belong to
# apps/web exclusively (Req 12.5).
# ═══════════════════════════════════════════════════════════════════

# ─── Database (Neon PostgreSQL) ──────────────────────────────────
# Same Neon branch as apps/web per environment (Req 12.2).
# Get from: https://console.neon.tech → Project → Connection Details
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct/unpooled connection (migrations, direct queries)
DATABASE_URL_UNPOOLED="postgresql://user:password@host-direct/dbname?sslmode=require"

# ─── Auth (Better Auth) ──────────────────────────────────────────
# BETTER_AUTH_SECRET MUST be the SAME value as apps/web so both apps
# validate the same session tokens (Req 4.2). Random 32+ char string.
BETTER_AUTH_SECRET="your-shared-better-auth-secret-min-32-chars"
# Admin origin so OAuth/session URLs resolve to the admin host.
BETTER_AUTH_URL="http://localhost:3001"

# ─── Auth (Google OAuth) ─────────────────────────────────────────
# Same OAuth app as apps/web.
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_OAUTH_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="your-google-client-secret"

# ─── Realtime (Ably) ─────────────────────────────────────────────
# Shared realtime key. Server issues subscribe-only admin tokens.
# Get from: https://ably.com/accounts → App → API Keys
ABLY_PRIVATE_KEY="your-ably-private-key"

# ─── Rate Limiting (Upstash Redis) ───────────────────────────────
# Sliding-window rate limiter on admin API routes.
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"

# ─── Webhook Signing (Upstash QStash) ────────────────────────────
# HMAC verification for QStash webhook receivers (jobs).
QSTASH_CURRENT_SIGNING_KEY="your-qstash-current-signing-key"
QSTASH_NEXT_SIGNING_KEY="your-qstash-next-signing-key"

# ─── Background Jobs (Upstash QStash publish) ─────────────────────
# QStash publish token. Required by the relocated background-job runtime:
# schedule registration (scripts/register-schedules.ts) and the triggered
# enqueue helper (src/lib/jobs/enqueue.ts) both publish with this.
# Get from: https://console.upstash.com → QStash → REST Token
QSTASH_TOKEN="your-qstash-publish-token"

# ─── Background Jobs (Invoice PDF render service) ─────────────────
# Cloud Run service (apps/invoicing) the relocated invoice-pdf job calls.
# OPTIONAL — the job degrades to a no-attachment email when either is unset.
INVOICING_SERVICE_URL="https://invoicing.example.run.app"
INVOICE_PDF_HMAC_SECRET="your-invoice-pdf-hmac-secret"

# ─── Client: App URL ─────────────────────────────────────────────
# Admin origin. Set to https://admin.theroyalglow.in in production (Req 12.3).
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# ─── Client: Observability (Sentry) ──────────────────────────────
# SEPARATE admin Sentry project, distinct from apps/web (Req 6.6, 12.3).
NEXT_PUBLIC_ADMIN_SENTRY_DSN="https://your-admin-sentry-dsn@sentry.io/admin-project-id"

# ─── Client: Google One Tap ──────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# ─── Client: Realtime (Ably) ─────────────────────────────────────
NEXT_PUBLIC_ABLY_KEY="your-ably-public-key"

# ─── CI/CD ───────────────────────────────────────────────────────
# Set truthy to bypass env validation for CI builds / Docker images (Req 12.6).
SKIP_ENV_VALIDATION="false"
