{
  "//": "Lighthouse CI config for the admin portal redesign (Req 18.6–18.8). Each redesigned route is audited; a11y/best-practices/SEO must be 100 and performance >= 0.95 to pass. Run: lhci autorun --config=apps/admin/lighthouserc.json against a built admin server (admin.theroyalglow.in or a local preview). Requires an authenticated session for the gated routes (seed via the e2e fixtures).",
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "url": [
        "http://localhost:3001/",
        "http://localhost:3001/bookings",
        "http://localhost:3001/customers",
        "http://localhost:3001/leads",
        "http://localhost:3001/billing",
        "http://localhost:3001/services",
        "http://localhost:3001/offers",
        "http://localhost:3001/memberships",
        "http://localhost:3001/staff",
        "http://localhost:3001/schedule",
        "http://localhost:3001/reports",
        "http://localhost:3001/settings",
        "http://localhost:3001/branches",
        "http://localhost:3001/users",
        "http://localhost:3001/integrations",
        "http://localhost:3001/logs"
      ]
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "categories:performance": ["warn", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
