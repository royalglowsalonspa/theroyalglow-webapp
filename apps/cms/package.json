{
  "name": "@rgss/cms",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "//dev": "Turbopack, the Next 16 default and the bundler `next build` uses. Until 27/09/2026 this was --webpack, because Windows Application Control on the maintainer's machine blocked the native SWC binary Turbopack needs; that binary loads again. `dev:webpack` is the fallback if it is ever blocked again.",
    "dev": "next dev --turbopack -p 3002",
    "dev:webpack": "next dev --webpack -p 3002",
    "build": "next build",
    "start": "next start",
    "start:prod": "next start -p ${PORT:-3002}",
    "generate:types": "payload generate:types",
    "migrate:create": "node scripts/create-migration.mjs",
    "migrate": "payload migrate",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-resend": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-mcp": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@rgss/db": "workspace:*",
    "@rgss/types": "workspace:*",
    "drizzle-orm": "0.45.2",
    "graphql": "^16.14.2",
    "nanoid": "6.0.1",
    "next": "16.3.5",
    "payload": "3.90.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "slugify": "1.6.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "fast-check": "^4.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "7.0.2"
  }
}
