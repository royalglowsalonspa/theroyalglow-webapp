# Payload CMS environment template — placeholders only, never commit real secrets.

# Secret used by Payload to sign/encrypt (min 32 chars in production).
PAYLOAD_SECRET=

# Neon Postgres connection string for the Payload-owned tables.
DATABASE_URL=

# Public URL where the Payload admin/API is served.
PAYLOAD_PUBLIC_SERVER_URL=https://admin.theroyalglow.in

# Web app origin allowed to read the REST API (CORS/CSRF).
WEB_APP_URL=https://theroyalglow.in

# Cloudflare R2 (S3-compatible) media storage.
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_URL=
