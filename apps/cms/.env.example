# Payload CMS environment template — placeholders only, never commit real secrets.
# Names are CANONICAL and match environment-variables.md + payload.config.ts.

# Secret used by Payload to sign/encrypt (min 32 chars in production).
PAYLOAD_SECRET=

# Neon Postgres connection string for the Payload-owned tables.
DATABASE_URL=

# Public URL where the Payload admin/API is served.
PAYLOAD_PUBLIC_SERVER_URL=https://cms.theroyalglow.in

# Web app origin allowed to read the REST API (CORS/CSRF).
WEB_APP_URL=https://theroyalglow.in

# Service sync to the app's public.service / public.service_category tables.
# Default ENABLED — only the literal value `false` turns the sync off, so an
# unset variable can never silently stop syncing. Set to `false` while running
# the seed script (apps/cms/scripts/seed-services.ts), and use it as the primary
# rollback lever (env change + restart, no code edit, no rebuild).
SERVICE_SYNC_ENABLED=true

# Cloudflare R2 (S3-compatible) media storage.
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional CMS email delivery.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=contact@theroyalglow.in
RESEND_FROM_NAME="Royal Glow Salon & Spa"

# Shared with apps/web for CMS-triggered path revalidation.
REVALIDATE_SECRET=
