# =============================================================================
# apps/cms runtime env -> SSM /rgss/prod/cms/env  (SecureString, Standard)
#   aws ssm put-parameter --name /rgss/prod/cms/env --type SecureString \
#     --tier Standard --overwrite --value "file://env/prod.cms.env"
#
# Payload owns the `cms` schema in the same database. `payload migrate` runs
# before boot (see docker-compose.yml) and needs a DIRECT session connection —
# on RDS every connection is direct, so the pgBouncer caveat from Neon is gone.
# =============================================================================

NODE_ENV=production

DATABASE_URL=postgresql://rgss_admin:REPLACE@rgss-prod-db.REPLACE.ap-south-1.rds.amazonaws.com:5432/rgss?sslmode=require
PAYLOAD_SECRET=REPLACE_MIN_32_CHARS
PAYLOAD_PUBLIC_SERVER_URL=https://cms.theroyalglow.in
WEB_APP_URL=https://theroyalglow.in

# --- Media storage (S3 via @payloadcms/storage-s3) ---------------------------
# The adapter only activates when the bucket + endpoint set is present.
# Credentials come from the EC2 instance role — do NOT set access keys.
# payload.config.ts currently hardcodes region 'auto' for R2; it must read
# AWS_REGION instead (M2AWS code change #3).
AWS_REGION=ap-south-1
R2_BUCKET_NAME=rgss-prod-media-REPLACE_ACCOUNT_ID
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.theroyalglow.in

# --- Admin emails (password reset, user invites) ------------------------------
RESEND_API_KEY=
RESEND_FROM_ADDRESS=contact@theroyalglow.in
RESEND_FROM_NAME=Royal Glow

# --- CMS -> web on-demand revalidation ---------------------------------------
REVALIDATE_SECRET=REPLACE_SHARED_WITH_WEB
