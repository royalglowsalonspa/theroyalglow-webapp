# =============================================================================
# apps/invoicing runtime env -> SSM /rgss/prod/invoicing/env (SecureString)
#   aws ssm put-parameter --name /rgss/prod/invoicing/env --type SecureString \
#     --tier Standard --overwrite --value "file://env/prod.invoicing.env"
#
# Internal service. Not routed through Caddy — only web and admin reach it, over
# the compose network at http://invoicing:8080.
# =============================================================================

NODE_ENV=production
PORT=8080

# --- PDF storage (S3; credentials from the EC2 instance role) ----------------
# src/storage/r2.ts hardcodes region 'auto' for R2 and requires R2_ENDPOINT;
# both must become AWS_REGION-driven (M2AWS code change #4). Leave R2_ENDPOINT
# unset so the SDK derives the S3 endpoint.
AWS_REGION=ap-south-1
R2_BUCKET_NAME=rgss-prod-media-REPLACE_ACCOUNT_ID
R2_PUBLIC_BASE_URL=https://media.theroyalglow.in

# --- Request authentication --------------------------------------------------
# HMAC shared with web + admin; the service rejects unsigned requests.
INVOICE_PDF_HMAC_SECRET=REPLACE_SAME_AS_WEB_AND_ADMIN

# --- Observability -----------------------------------------------------------
SENTRY_DSN=
