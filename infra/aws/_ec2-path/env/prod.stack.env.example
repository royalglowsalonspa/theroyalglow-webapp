# =============================================================================
# Stack-level values -> SSM /rgss/prod/stack/env  (SecureString, Standard)
#   aws ssm put-parameter --name /rgss/prod/stack/env --type SecureString \
#     --tier Standard --overwrite --value "file://env/prod.stack.env"
#
# These are consumed by docker-compose.yml itself (interpolated by deploy.sh),
# not by any single app. Defined exactly once so the value cannot skew between
# the SRH proxy and the apps that talk to it.
# =============================================================================

# Let's Encrypt registration address for Caddy.
ACME_EMAIL=contact@theroyalglow.in

# Shared secret between SRH and every @upstash/redis client. MUST equal
# UPSTASH_REDIS_REST_TOKEN in prod.web.env and prod.admin.env.
SRH_TOKEN=REPLACE_openssl_rand_hex_32
