# =============================================================================
# apps/web runtime env -> SSM /rgss/prod/web/env  (SecureString, Standard tier)
# -----------------------------------------------------------------------------
#   cp prod.web.env.example prod.web.env   # fill in, then:
#   aws ssm put-parameter --name /rgss/prod/web/env --type SecureString \
#     --tier Standard --overwrite --value "file://env/prod.web.env"
#   shred -u prod.web.env
#
# Standard-tier parameters cap at 4 KB — keep this file lean or it stops being
# free. prod.*.env is gitignored; SSM is the system of record.
#
# NOTE: NEXT_PUBLIC_* vars are NOT here. They are inlined into the client bundle
# at BUILD time and are passed as --build-arg by .github/workflows/deploy-aws.yml.
# Setting them here has no effect on the browser bundle.
# =============================================================================

APP_ENV=prod
NODE_ENV=production

# --- Database (M2AWS §7) -----------------------------------------------------
# DB_DRIVER=pg selects the node-postgres client; 'neon' keeps the Neon HTTP
# driver for rollback. RDS enforces TLS (rds.force_ssl=1).
DB_DRIVER=pg
DATABASE_URL=postgresql://rgss_admin:REPLACE@rgss-prod-db.REPLACE.ap-south-1.rds.amazonaws.com:5432/rgss?sslmode=require

# --- Auth --------------------------------------------------------------------
# BETTER_AUTH_SECRET MUST be byte-identical to the admin app's value: sessions
# are shared across subdomains via a .theroyalglow.in-scoped cookie.
BETTER_AUTH_SECRET=REPLACE_32_CHARS_MIN
BETTER_AUTH_URL=https://theroyalglow.in
GOOGLE_OAUTH_CLIENT_ID=REPLACE.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE

# --- Email (M2AWS §13) -------------------------------------------------------
# EMAIL_PROVIDER=ses uses SESv2 with the EC2 instance role — no API key.
# Set 'resend' to fall back without a redeploy.
EMAIL_PROVIDER=ses
SES_FROM_EMAIL=Royal Glow <contact@theroyalglow.in>
RESEND_API_KEY=

# --- Storage (M2AWS §8) ------------------------------------------------------
# No access keys: the instance role supplies S3 credentials. R2_ENDPOINT must be
# UNSET so the SDK derives the S3 endpoint from AWS_REGION.
AWS_REGION=ap-south-1
R2_BUCKET_NAME=rgss-prod-media-REPLACE_ACCOUNT_ID

# --- Cache + rate limit (M2AWS §12) -----------------------------------------
# SRH speaks the Upstash REST dialect in front of Valkey, so the var names stay.
UPSTASH_REDIS_REST_URL=http://srh:8079
UPSTASH_REDIS_REST_TOKEN=REPLACE_MATCHES_SRH_TOKEN

# --- Background jobs (M2AWS §11) --------------------------------------------
# QSTASH_* intentionally unset: EventBridge Scheduler authenticates with the
# INTERNAL_JOB_TOKEN header instead.
INTERNAL_JOB_TOKEN=REPLACE_openssl_rand_hex_32
JOB_SCHEDULER=aws

# --- Realtime (still Ably — M2AWS §14 deferred) -----------------------------
ABLY_PRIVATE_KEY=REPLACE

# --- Web Push ----------------------------------------------------------------
VAPID_PRIVATE_KEY=REPLACE
VAPID_SUBJECT=mailto:contact@theroyalglow.in

# --- Internal services -------------------------------------------------------
INVOICING_SERVICE_URL=http://invoicing:8080
INVOICE_PDF_HMAC_SECRET=REPLACE_SHARED_WITH_INVOICING

# --- Optional ----------------------------------------------------------------
CONTACT_INBOX_EMAIL=contact@theroyalglow.in
META_PIXEL_ACCESS_TOKEN=
SLACK_WEBHOOK_URL=
DAILY_REPORT_EMAIL_RECIPIENTS=
REVALIDATE_SECRET=REPLACE_SHARED_WITH_CMS
