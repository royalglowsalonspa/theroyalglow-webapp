# =============================================================================
# apps/admin runtime env -> SSM /rgss/prod/admin/env  (SecureString, Standard)
#   aws ssm put-parameter --name /rgss/prod/admin/env --type SecureString \
#     --tier Standard --overwrite --value "file://env/prod.admin.env"
#
# The admin app is ALSO the background-job target: EventBridge Scheduler POSTs
# to admin.theroyalglow.in/api/jobs/* with the x-internal-job-token header.
# =============================================================================

APP_ENV=prod
NODE_ENV=production

# --- Database ----------------------------------------------------------------
# Admin's env.ts requires both hosts. On RDS there is no pgBouncer split, so
# both point at the same endpoint; the distinction stays for portability.
DB_DRIVER=pg
DATABASE_URL=postgresql://rgss_admin:REPLACE@rgss-prod-db.REPLACE.ap-south-1.rds.amazonaws.com:5432/rgss?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://rgss_admin:REPLACE@rgss-prod-db.REPLACE.ap-south-1.rds.amazonaws.com:5432/rgss?sslmode=require

# --- Auth (BETTER_AUTH_SECRET MUST equal the web app's value) ----------------
BETTER_AUTH_SECRET=REPLACE_SAME_AS_WEB
BETTER_AUTH_URL=https://admin.theroyalglow.in
GOOGLE_OAUTH_CLIENT_ID=REPLACE.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE

# --- Email -------------------------------------------------------------------
EMAIL_PROVIDER=ses
SES_FROM_EMAIL=Royal Glow <contact@theroyalglow.in>
RESEND_API_KEY=

# --- Storage -----------------------------------------------------------------
AWS_REGION=ap-south-1
R2_BUCKET_NAME=rgss-prod-media-REPLACE_ACCOUNT_ID

# --- Cache + rate limit ------------------------------------------------------
UPSTASH_REDIS_REST_URL=http://srh:8079
UPSTASH_REDIS_REST_TOKEN=REPLACE_MATCHES_SRH_TOKEN

# --- Background jobs ---------------------------------------------------------
# Same token the EventBridge connection sends. QSTASH_* stay unset.
INTERNAL_JOB_TOKEN=REPLACE_SAME_AS_WEB
JOB_SCHEDULER=aws
JOB_SCHEDULE_GROUP=rgss-prod-jobs

# --- Realtime ----------------------------------------------------------------
ABLY_PRIVATE_KEY=REPLACE

# --- Internal services -------------------------------------------------------
INVOICING_SERVICE_URL=http://invoicing:8080
INVOICE_PDF_HMAC_SECRET=REPLACE_SHARED_WITH_INVOICING

# --- Observability (BetterStack heartbeats keep working — outbound pings) ----
BETTER_STACK_HEARTBEAT_NIGHTLY_SALES=
BETTER_STACK_HEARTBEAT_REMINDERS=
BETTER_STACK_HEARTBEAT_MEMBERSHIP_EXPIRY=
BETTER_STACK_HEARTBEAT_SESSION_CLEANUP=
BETTER_STACK_HEARTBEAT_SERVICE_DRIFT=
SLACK_WEBHOOK_URL=
DAILY_REPORT_EMAIL_RECIPIENTS=
