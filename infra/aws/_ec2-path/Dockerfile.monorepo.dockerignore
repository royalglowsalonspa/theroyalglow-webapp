# Build-context ignore rules for infra/aws/Dockerfile.monorepo.
# BuildKit prefers <dockerfile>.dockerignore over the root .dockerignore, so the
# CMS-only rules at the repo root stay untouched.
#
# Difference that matters: docs/ and **/*.md are KEPT here — the MDX
# documentation content is retained in the context, though there is no docs app
# to build (Mintlify hosts and builds the docs site from the repo).

# Reinstalled / rebuilt inside the image
**/node_modules
**/.next
**/.turbo
**/.open-next
**/dist
**/.cache

# VCS, CI, tooling, local state
.git
.github
.husky
.vscode
.kiro
.code-review-graph
graphify-out
.turbo

# Secrets — never bake into an image
**/.env
**/.env.*
!**/.env.example
infra/aws/env/*.env

# Test + report output
**/playwright-report
**/test-results
**/coverage
**/*.log

# Local artefacts
**/.DS_Store
**/*.tsbuildinfo
