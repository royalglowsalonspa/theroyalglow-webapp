{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "Snyk": {
      "type": "local",
      "command": [
        "snyk",
        "mcp",
        "-t",
        "stdio"
      ],
      "timeout": 60000,
      "enabled": true
    },
    "socket-mcp": {
      "type": "remote",
      "url": "https://mcp.socket.dev/",
      "enabled": true
    },
    "neon": {
      "type": "remote",
      "url": "https://mcp.neon.tech/mcp",
      "headers": {
        "Authorization": "Bearer {env:NEON_API_KEY_RGSS}"
      },
      "enabled": true
    },
    "code-review-graph": {
      "type": "local",
      "command": [
        "code-review-graph",
        "serve",
        "--repo",
        "."
      ],
      "cwd": ".",
      "environment": {
        "PYTHONUTF8": "1"
      },
      "timeout": 60000,
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "command": [
        "shadcn",
        "mcp"
      ],
      "timeout": 60000,
      "enabled": true
    },
    "cloudflare-api": {
      "type": "local",
      "command": [
        "mcp-remote",
        "https://mcp.cloudflare.com/mcp",
        "--header",
        "Authorization:Bearer {env:CLOUDFLARE_API_TOKEN_RGSS}"
      ],
      "environment": {
        "CLOUDFLARE_API_TOKEN": "{env:CLOUDFLARE_API_TOKEN_RGSS}"
      },
      "timeout": 60000,
      "enabled": true
    },
    "cloudflare-bindings": {
      "type": "local",
      "command": [
        "mcp-remote",
        "https://bindings.mcp.cloudflare.com/mcp"
      ],
      "timeout": 60000,
      "enabled": true
    },
    "cloudflare-builds": {
      "type": "local",
      "command": [
        "mcp-remote",
        "https://builds.mcp.cloudflare.com/mcp"
      ],
      "timeout": 60000,
      "enabled": true
    },
    "cloudflare-observability": {
      "type": "local",
      "command": [
        "mcp-remote",
        "https://observability.mcp.cloudflare.com/mcp"
      ],
      "timeout": 60000,
      "enabled": true
    },
    "cloudflare-docs": {
      "type": "local",
      "command": [
        "mcp-remote",
        "https://docs.mcp.cloudflare.com/mcp"
      ],
      "timeout": 60000,
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PAT_RGSS}"
      },
      "enabled": true
    },
    "posthog": {
      "type": "local",
      "command": [
        "mcp-remote",
        "https://mcp.eu.posthog.com/mcp",
        "--header",
        "Authorization:Bearer {env:POSTHOG_AUTH_HEADER_RGSS}"
      ],
      "environment": {
        "POSTHOG_AUTH_HEADER": "{env:POSTHOG_AUTH_HEADER_RGSS}"
      },
      "timeout": 60000,
      "enabled": true
    },
    "mintlify-admin": {
      "type": "remote",
      "url": "https://mcp.mintlify.com",
      "enabled": true
    },
    "mintlify-search": {
      "type": "remote",
      "url": "https://mintlify.com/docs/mcp",
      "enabled": true
    },
    "sentry": {
      "type": "local",
      "command": [
        "mcp-remote",
        "https://mcp.sentry.dev/mcp"
      ],
      "timeout": 60000,
      "enabled": true
    },
    "payload": {
      "type": "local",
      "command": [
        "mcp-remote",
        "http://localhost:3002/api/mcp",
        "--header",
        "Authorization:Bearer {env:PAYLOAD_MCP_API_KEY_RGSS}",
        "--allow-http"
      ],
      "environment": {
        "PAYLOAD_MCP_API_KEY": "{env:PAYLOAD_MCP_API_KEY_RGSS}"
      },
      "timeout": 60000,
      "enabled": true
    }
  },
  "experimental": {
    "mcp_timeout": 60000
  }
}
