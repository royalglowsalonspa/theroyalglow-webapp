{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "Snyk": {
      "type": "local",
      "command": ["npx", "-y", "snyk@latest", "mcp", "-t", "stdio"],
      "enabled": true
    },
    "neon": {
      "type": "local",
      "command": ["npx", "-y", "@neondatabase/mcp-server-neon"],
      "environment": {
        "NEON_API_KEY": "{env:NEON_API_KEY_RGSS}"
      },
      "enabled": true
    },
    "code-review-graph": {
      "type": "local",
      "command": [
        "code-review-graph",
        "serve",
        "--repo",
        "C:\\Users\\kbose\\OneDrive\\Desktop\\rgss_website_v1"
      ],
      "environment": {
        "PYTHONUTF8": "1"
      },
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true
    },
    "cloudflare-api": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://mcp.cloudflare.com/mcp"],
      "enabled": true
    },
    "cloudflare-bindings": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://bindings.mcp.cloudflare.com/mcp"],
      "enabled": true
    },
    "cloudflare-builds": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://builds.mcp.cloudflare.com/mcp"],
      "enabled": true
    },
    "cloudflare-observability": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://observability.mcp.cloudflare.com/mcp"],
      "enabled": true
    },
    "cloudflare-docs": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://docs.mcp.cloudflare.com/mcp"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://api.githubcopilot.com/mcp/",
        "--header",
        "Authorization:Bearer ${GITHUB_PAT}"
      ],
      "environment": {
        "GITHUB_PAT": "{env:GITHUB_PAT_RGSS}"
      },
      "enabled": true
    },
    "posthog": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.eu.posthog.com/mcp",
        "--header",
        "Authorization:Bearer ${POSTHOG_AUTH_HEADER}"
      ],
      "environment": {
        "POSTHOG_AUTH_HEADER": "{env:POSTHOG_AUTH_HEADER_RGSS}"
      },
      "enabled": true
    },
    "mintlify-admin": {
      "type": "remote",
      "url": "https://mcp.mintlify.com",
      "enabled": true
    },
    "mintlify-search": {
      "type": "remote",
      "url": "https://mintlify.com/docs/mcp",
      "enabled": true
    },
    "sentry": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://mcp.sentry.dev/mcp"],
      "enabled": true
    },
    "payload": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "http://localhost:3002/api/mcp",
        "--header",
        "Authorization:Bearer ${PAYLOAD_MCP_API_KEY}",
        "--allow-http"
      ],
      "environment": {
        "PAYLOAD_MCP_API_KEY": "{env:PAYLOAD_MCP_API_KEY_RGSS}"
      },
      "enabled": true
    }
  }
}
