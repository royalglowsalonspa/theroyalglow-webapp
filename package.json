{
  "name": "theroyalglow-webapp",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*",
    "docs"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --exclude '**/*.integration.test.*' --exclude '**/e2e/**'",
    "test:unit": "vitest run --exclude '**/*.integration.test.*' --exclude '**/e2e/**'",
    "test:integration": "vitest run --config vitest.integration.config.ts integration.test.ts",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage --exclude '**/*.integration.test.*' --exclude '**/e2e/**'",
    "clean": "turbo run clean",
    "generate": "bun run --filter=@rgss/db generate",
    "migrate": "bun run --filter=@rgss/db migrate",
    "check:cutover": "node scripts/assert-no-admin-artifacts.mjs",
    "check:admin-no-literals": "node scripts/admin-design/no-brand-literals.mjs",
    "check:admin-path-allowlist": "node scripts/admin-design/path-allowlist.mjs",
    "check:admin-root-path": "node scripts/admin-design/root-path-convention.mjs",
    "check:no-emoji": "node scripts/assert-no-emoji-icons.mjs",
    "set-role": "bun run packages/db/scripts/set-role.ts",
    "provision:betterstack": "bun run scripts/provision-betterstack.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^6.1.0",
    "checkly": "^8.22.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "sst": "^4.17.1",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "kysely": "0.29.4",
    "zod": "4.4.3",
    "dompurify": "3.4.14",
    "postcss": "8.5.26",
    "form-data": "4.0.6",
    "undici": "7.29.0",
    "esbuild": "0.25.12",
    "brace-expansion": "5.0.9",
    "sharp": "0.35.3",
    "shell-quote": "1.10.0",
    "fast-uri": "3.1.5",
    "ip-address": "10.5.0",
    "hono": "4.13.5",
    "immutable": "4.3.9",
    "js-yaml": "5.2.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@hono/node-server": "2.0.12"
  },
  "lint-staged": {
    "*.{ts,tsx,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "nanoid": "^6.0.1"
  }
}
