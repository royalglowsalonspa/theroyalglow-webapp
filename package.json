{
  "name": "theroyalglow-webapp",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": ["apps/*", "packages/*", "docs"],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --exclude '**/*.integration.test.*' --exclude '**/e2e/**'",
    "test:unit": "vitest run --exclude '**/*.integration.test.*' --exclude '**/e2e/**'",
    "test:integration": "vitest run integration.test.ts",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage --exclude '**/*.integration.test.*' --exclude '**/e2e/**'",
    "clean": "turbo run clean",
    "check:cutover": "node scripts/assert-no-admin-artifacts.mjs",
    "check:admin-no-literals": "node scripts/admin-design/no-brand-literals.mjs",
    "check:admin-path-allowlist": "node scripts/admin-design/path-allowlist.mjs",
    "check:admin-root-path": "node scripts/admin-design/root-path-convention.mjs",
    "check:no-emoji": "node scripts/assert-no-emoji-icons.mjs",
    "set-role": "bun run packages/db/scripts/set-role.ts",
    "provision:betterstack": "bun run scripts/provision-betterstack.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@playwright/test": "^1.62.0",
    "@vitejs/plugin-react": "^6.0.4",
    "checkly": "^8.17.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "turbo": "^2.10.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "kysely": "0.29.4",
    "zod": "4.4.3",
    "dompurify": "3.4.12",
    "postcss": "8.5.23",
    "form-data": "4.0.6",
    "undici": "7.28.0",
    "esbuild": "0.25.12",
    "brace-expansion": "5.0.8",
    "sharp": "0.35.3",
    "shell-quote": "1.10.0",
    "fast-uri": "3.1.4",
    "immutable": "4.3.9",
    "js-yaml": "5.2.2"
  },
  "lint-staged": {
    "*.{ts,tsx,json,css}": ["biome check --write"]
  }
}
