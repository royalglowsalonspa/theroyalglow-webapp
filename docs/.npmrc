# Build-pipeline hygiene for the Sevalla (Nixpacks) docs deploy, which installs
# with npm in this subfolder. Keeps the deploy log clean (zero warnings):
#   - loglevel=error  : suppress npm's `warn` chatter — notably the deprecated
#                       `config production` notice (Sevalla sets NODE_ENV) and
#                       EBADENGINE for jsdom (a test-only devDep that is never
#                       used in the docs build or runtime).
#   - fund=false      : drop the "packages are looking for funding" notice.
#   - audit=false     : drop the post-install vulnerability summary.
#   - legacy-peer-deps: npm's resolver is stricter than bun (the repo's package
#                       manager); fumadocs-mdx@15 pairs with fumadocs-*@16 by
#                       design, so allow the peer set npm would otherwise reject.
loglevel=error
fund=false
audit=false
legacy-peer-deps=true
