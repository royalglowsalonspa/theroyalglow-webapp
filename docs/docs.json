{
  "theme": "aspen",
  "name": "Royal Glow Salon & Spa",
  "description": "Product, engineering, operations, and API documentation for the Royal Glow Salon & Spa platform — the digital operations system behind a premium beauty and wellness business in Bengaluru.",
  "colors": {
    "primary": "#7D5C12",
    "light": "#F4E09B",
    "dark": "#7D5C12"
  },
  "logo": {
    "light": "/logo/brand.png",
    "dark": "/logo/brand.png",
    "href": "https://theroyalglow.in"
  },
  "favicon": "/favicon.png",
  "appearance": {
    "default": "light",
    "strict": false
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#1A0F0A"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "gruvbox-light-medium",
        "dark": "gruvbox-dark-medium"
      }
    }
  },
  "interaction": {
    "drilldown": false
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/royalglowsalonspa/theroyalglow-webapp",
        "icon": "github"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Book Now",
      "href": "https://theroyalglow.in/?book=1"
    }
  },
  "footer": {
    "socials": {
      "website": "https://theroyalglow.in",
      "github": "https://github.com/royalglowsalonspa/theroyalglow-webapp"
    },
    "links": [
      {
        "header": "Documentation",
        "items": [
          { "label": "Overview", "href": "/content/docs/index" },
          { "label": "Product", "href": "/content/docs/product/index" },
          { "label": "Features", "href": "/content/docs/features/index" },
          { "label": "FAQ", "href": "/content/docs/faq" }
        ]
      },
      {
        "header": "Engineering",
        "items": [
          { "label": "Getting started", "href": "/content/docs/getting-started" },
          { "label": "Architecture", "href": "/content/docs/architecture" },
          { "label": "System design", "href": "/content/docs/system-design/index" },
          { "label": "Operations", "href": "/content/docs/operations" }
        ]
      },
      {
        "header": "API reference",
        "items": [
          { "label": "Overview", "href": "/content/docs/api-reference/index" },
          { "label": "Services", "href": "/content/docs/api-reference/services" },
          { "label": "Bookings", "href": "/content/docs/api-reference/bookings" },
          { "label": "Background jobs", "href": "/content/docs/api-reference/jobs" }
        ]
      },
      {
        "header": "Royal Glow",
        "items": [
          { "label": "Main site", "href": "https://theroyalglow.in" },
          { "label": "Admin portal", "href": "https://admin.theroyalglow.in" },
          { "label": "Status page", "href": "https://status.theroyalglow.in" },
          { "label": "GitHub", "href": "https://github.com/royalglowsalonspa/theroyalglow-webapp" }
        ]
      }
    ]
  },
  "contextual": {
    "display": "header",
    "options": ["copy", "view", "chatgpt", "claude", "cursor", "mcp"]
  },
  "navigation": {
    "versions": [
      {
        "version": "Current",
        "default": true,
        "tag": "Latest",
        "tabs": [
          {
            "tab": "Documentation",
            "icon": "book-open",
            "groups": [
              {
                "group": "Overview",
                "icon": "compass",
                "pages": ["content/docs/index", "content/docs/project-status"]
              },
              {
                "group": "Product",
                "icon": "users",
                "pages": [
                  "content/docs/product/index",
                  "content/docs/product/business-overview",
                  "content/docs/product/customer-guide",
                  "content/docs/product/admin-staff-guide"
                ]
              },
              {
                "group": "Features",
                "icon": "sparkles",
                "pages": [
                  "content/docs/features/index",
                  "content/docs/features/booking",
                  "content/docs/features/booking-rules",
                  "content/docs/features/memberships",
                  "content/docs/features/loyalty-gems",
                  "content/docs/features/offers",
                  "content/docs/features/crm-leads",
                  "content/docs/features/scheduling-leave",
                  "content/docs/features/billing-invoicing",
                  "content/docs/features/notifications",
                  "content/docs/features/no-show-policy",
                  "content/docs/features/favourite-services"
                ]
              },
              {
                "group": "Reference",
                "icon": "book",
                "pages": ["content/docs/glossary", "content/docs/faq"]
              }
            ]
          },
          {
            "tab": "Engineering",
            "icon": "code",
            "groups": [
              {
                "group": "Getting started",
                "icon": "rocket",
                "pages": [
                  "content/docs/getting-started",
                  "content/docs/tech-stack",
                  "content/docs/architecture"
                ]
              },
              {
                "group": "System design",
                "icon": "layers",
                "pages": [
                  "content/docs/system-design/index",
                  "content/docs/system-design/high-level-design",
                  "content/docs/system-design/low-level-design"
                ]
              },
              {
                "group": "Standards",
                "icon": "shield-check",
                "pages": [
                  "content/docs/conventions",
                  "content/docs/authentication",
                  "content/docs/data-model"
                ]
              },
              {
                "group": "Application surface",
                "icon": "monitor",
                "pages": ["content/docs/pages-and-routes", "content/docs/frontend"]
              },
              {
                "group": "Platform",
                "icon": "server",
                "pages": [
                  "content/docs/background-jobs",
                  "content/docs/realtime",
                  "content/docs/notifications-email",
                  "content/docs/seo",
                  "content/docs/analytics",
                  "content/docs/observability"
                ]
              },
              {
                "group": "Quality & security",
                "icon": "lock",
                "pages": [
                  "content/docs/security",
                  "content/docs/error-handling",
                  "content/docs/testing",
                  "content/docs/environment-variables"
                ]
              },
              {
                "group": "Operations",
                "icon": "wrench",
                "pages": [
                  "content/docs/deployment",
                  "content/docs/git-workflow",
                  "content/docs/data-seeding",
                  "content/docs/operations"
                ]
              }
            ]
          },
          {
            "tab": "API reference",
            "icon": "plug",
            "groups": [
              {
                "group": "API reference",
                "icon": "plug",
                "pages": [
                  "content/docs/api-reference/index",
                  "content/docs/api-reference/services",
                  "content/docs/api-reference/bookings",
                  "content/docs/api-reference/admin-bookings",
                  "content/docs/api-reference/customers-crm",
                  "content/docs/api-reference/leads",
                  "content/docs/api-reference/memberships",
                  "content/docs/api-reference/loyalty-offers",
                  "content/docs/api-reference/notifications",
                  "content/docs/api-reference/jobs",
                  "content/docs/api-reference/health"
                ]
              }
            ]
          }
        ]
      },
      {
        "version": "v2",
        "tag": "Legacy",
        "groups": [
          {
            "group": "Overview",
            "icon": "compass",
            "pages": ["content/docs-v2/index", "content/docs-v2/getting-started"]
          },
          {
            "group": "Engineering",
            "icon": "code",
            "pages": ["content/docs-v2/features/index", "content/docs-v2/features/booking"]
          }
        ]
      }
    ]
  },
  "search": {
    "prompt": "Search Royal Glow documentation"
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "Royal Glow Salon & Spa Documentation",
